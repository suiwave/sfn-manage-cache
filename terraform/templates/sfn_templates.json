{
    "Comment": "A description of my state machine",
    "StartAt": "Query Cache",
    "States": {
        "Query Cache": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "OutputPath": "$.Payload",
            "Parameters": {
                "Payload.$": "$",
                "FunctionName": "${lambda_redis_get_arn}:$LATEST"
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 1,
                    "MaxAttempts": 3,
                    "BackoffRate": 2
                }
            ],
            "Next": "Choice"
        },
        "Choice": {
            "Type": "Choice",
            "Choices": [
                {
                    "Not": {
                        "Variable": "$.cache",
                        "IsNull": true
                    },
                    "Next": "Cache Hit!"
                },
                {
                    "Or": [
                        {
                            "Variable": "$.cache",
                            "IsPresent": false
                        },
                        {
                            "Variable": "$.cache",
                            "IsNull": true
                        }
                    ],
                    "Next": "Cache miss..."
                }
            ]
        },
        "Cache Hit!": {
            "Type": "Pass",
            "Next": "Success",
            "Parameters": {
                "user.$": "$.cache"
            }
        },
        "Cache miss...": {
            "Type": "Pass",
            "Next": "Query Origin"
        },
        "Query Origin": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "OutputPath": "$.Payload",
            "Parameters": {
                "FunctionName": "${lambda_postgresql_arn}:$LATEST",
                "Payload": {
                    "email.$": "$$.Execution.Input.email"
                }
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 1,
                    "MaxAttempts": 3,
                    "BackoffRate": 2
                }
            ],
            "Next": "Set Cache"
        },
        "Set Cache": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "OutputPath": "$.Payload",
            "Parameters": {
                "Payload.$": "$",
                "FunctionName": "${lambda_redis_set_arn}:$LATEST"
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 1,
                    "MaxAttempts": 3,
                    "BackoffRate": 2
                }
            ],
            "Next": "Success"
        },
        "Success": {
            "Type": "Succeed"
        }
    }
}